+import androidx.compose.runtime.Composable
+import androidx.navigation.NavType
+import androidx.navigation.compose.NavHost
+import androidx.navigation.compose.composable
+import androidx.navigation.compose.rememberNavController
+import androidx.navigation.navArgument
 
 class MainActivity : ComponentActivity() {
     override fun onCreate(savedInstanceState: Bundle?) {
         super.onCreate(savedInstanceState)
         setContent {
             MaterialTheme {
-                AppListScreen(apps = sampleApps)
+                AppNavHost()
+            }
+        }
+    }
+}
+
+@Composable
+fun AppNavHost() {
+    val navController = rememberNavController()
+
+    NavHost(
+        navController = navController,
+        startDestination = "app_list"
+    ) {
+        composable("app_list") {
+            AppListScreen(
+                apps = sampleApps,
+                onAppClick = { app ->
+                    navController.navigate("app_details/${app.id}")
+                },
+                onShowcaseAppClick = {
+                    // Клик по приложению из «Витрины» → возврат к списку приложений
+                    navController.navigate("app_list") {
+                        popUpTo("app_list") { inclusive = true }
+                        launchSingleTop = true
+                    }
+                }
+            )
+        }
+
+        composable(
+            route = "app_details/{appId}",
+            arguments = listOf(navArgument("appId") { type = NavType.IntType })
+        ) { backStackEntry ->
+            val appId = backStackEntry.arguments?.getInt("appId")
+            val app = sampleApps.find { it.id == appId }
+            if (app != null) {
+                AppDetailsScreen(
+                    app = app,
+                    onBack = { navController.popBackStack() }
+                )
             }
         }
     }
